---
type Props = {
  title: string;
  description?: string;
  /**
   * Extra attributes for the <html> element.
   *
   * The escape hatch for consumers that re-point theme roles per page: the
   * tokens are plain custom properties, so setting them here cascades to
   * everything, chrome included.
   *
   *   htmlAttrs={{ style: "--color-accent:#4a9eff", "data-post": "oban" }}
   */
  htmlAttrs?: Record<string, string | undefined>;
  /** Extra classes for <body>. */
  bodyClass?: string;
  /**
   * The tab icon. A string is used as the href of a single <link rel="icon">.
   *
   * Pass `false` for a real icon set — an .ico, the PNG sizes, apple-touch,
   * a manifest — and declare the whole set in the `head` slot. That is the
   * only way to be rid of this one: a second `rel="icon"` does not replace
   * the first, it competes with it, and which one the browser keeps is its
   * choice rather than the consumer's.
   */
  favicon?: string | false;
  /**
   * Where Crimson Pro and IBM Plex Mono come from. A string replaces the
   * stylesheet URL, and drops the preconnects with it.
   *
   * Pass `false` to self-host. The link is render-blocking and points at an
   * origin the page otherwise never touches, so it costs a DNS lookup, a TLS
   * handshake and a round trip before first paint — then a second set for the
   * font files on fonts.gstatic.com. A consumer that does this must declare
   * the faces itself; the theme only ever names them through --font-display
   * and --font-body.
   */
  fonts?: string | false;
};

/** Pressmark's own mark, so the demo has a tab icon. Consumers replace it. */
const PLACEHOLDER_FAVICON =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%23F6F4EE'/%3E%3Ctext x='50%25' y='62%25' text-anchor='middle' font-family='Georgia,serif' font-size='22' fill='%231F1F1F'%3EP%3C/text%3E%3C/svg%3E";

/** The two faces the theme's type scale is drawn for. */
const GOOGLE_FONTS_HREF =
  "https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300..700;1,300..700&family=IBM+Plex+Mono:wght@400;500&display=swap";

const {
  title,
  description,
  htmlAttrs = {},
  bodyClass = "",
  favicon = PLACEHOLDER_FAVICON,
  fonts = GOOGLE_FONTS_HREF,
} = Astro.props as Props;
---

<!doctype html>
<html lang="en" {...htmlAttrs}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {favicon && <link rel="icon" href={favicon} />}
    {/* The preconnects warm up Google's two origins, so they are tied to that
        URL rather than to `fonts` being set — pointed at a consumer's own host
        they would open a connection nothing goes on to use. */}
    {fonts === GOOGLE_FONTS_HREF && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      </>
    )}
    {fonts && <link href={fonts} rel="stylesheet" />}
    <slot name="head" />
  </head>
  <body class:list={["min-h-screen", bodyClass]}>
    <slot name="sidebar" />
    <slot />

    <script>
      // Progressive enhancement: wire up code-block copy buttons. The buttons
      // are rendered `hidden` server-side so no-JS pages show no broken control;
      // we reveal them here and attach the clipboard handler. Mirrors the
      // TableOfContents scroll-spy pattern (DS-owned inline script).
      const buttons = document.querySelectorAll<HTMLButtonElement>(
        "button[data-pressmark-copy]",
      );

      // Shiki renders one `.line` span per line (the rehype pipeline strips the
      // `\n` text nodes between them), so textContent would collapse the code
      // onto one line. Join the `.line` spans with newlines to preserve breaks
      // and indentation; fall back to the raw textContent for non-Shiki bodies.
      function extractCode(body: Element): string {
        const lines = body.querySelectorAll(".line");
        if (lines.length) {
          return Array.from(lines)
            .map((line) => line.textContent ?? "")
            .join("\n");
        }
        return (body.textContent ?? "").replace(/\n$/, "");
      }

      buttons.forEach((button) => {
        if (!navigator.clipboard) return; // no clipboard API → leave hidden
        button.hidden = false;

        let resetTimer: ReturnType<typeof setTimeout> | undefined;

        button.addEventListener("click", async () => {
          const figure = button.closest(".code-block");
          const body = figure?.querySelector(".code-block-body");
          if (!body) return;

          try {
            await navigator.clipboard.writeText(extractCode(body));
          } catch {
            return;
          }

          button.setAttribute("data-copied", "");
          button.setAttribute("aria-label", "Copied");
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            button.removeAttribute("data-copied");
            button.setAttribute("aria-label", "Copy code");
          }, 1500);
        });
      });
    </script>

    <script>
      // Progressive enhancement: dim any .sidebar-fade-on-scroll element once
      // the reader scrolls into the article, so the nav recedes while reading.
      // Hover/focus-within restore full opacity via CSS (:hover beats .is-faded).
      // Without JS the class never gains .is-faded, so the nav stays visible.
      const faders = document.querySelectorAll<HTMLElement>(
        ".sidebar-fade-on-scroll",
      );
      if (faders.length) {
        const THRESHOLD = 280; // px scrolled before the nav starts to dim
        let ticking = false;
        const apply = () => {
          const faded = window.scrollY > THRESHOLD;
          faders.forEach((el) => el.classList.toggle("is-faded", faded));
          ticking = false;
        };
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(apply);
        };
        apply();
        window.addEventListener("scroll", onScroll, { passive: true });
      }
    </script>
  </body>
</html>
