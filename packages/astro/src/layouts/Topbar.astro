---
/**
 * Topbar — a horizontal nav shell, sibling to Sidebar.
 *
 * Use when a site has few enough destinations that a 260px rail is wasted
 * space. Pairs with a centred content column; Sidebar pairs with a left-
 * anchored one.
 *
 * Content below it needs clearance for the fixed bar:
 *
 *   <Topbar items={items} currentPath={Astro.url.pathname} />
 *   <main class="pt-14 px-6 py-10">…</main>
 */
import { withBase, isActive, type NavItem } from "../lib/nav.ts";

export type TopbarItem = NavItem;

type Props = {
  brand?: string;
  brandHref?: string;
  items?: TopbarItem[];
  currentPath?: string;
  class?: string;
  /** Show item icons. Off by default — a top bar is tighter than a rail. */
  showIcons?: boolean;
};

const {
  brand,
  brandHref = "/",
  items = [],
  currentPath = "/",
  class: className = "",
  showIcons = false,
} = Astro.props as Props;
---

<header
  class:list={[
    "fixed top-0 inset-x-0 z-30 h-14 bg-surface border-b border-raised",
    className,
  ]}
>
  <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-6 h-full px-5 md:px-8">
    <div class="flex items-center min-w-0">
      {brand && (
        <a
          href={withBase(brandHref)}
          class="shrink-0 font-display text-2xl tracking-tight text-ink leading-none"
        >
          {brand}
        </a>
      )}
    </div>

    {items.length > 0 ? (
      <nav
        class="nav-scroll flex items-center justify-center gap-1 min-w-0 overflow-x-auto"
        aria-label="Primary"
      >
        {items.map((item) => {
          const active = isActive(item.href, currentPath);
          return (
            <a
              href={withBase(item.href)}
              class:list={[
                "flex items-center gap-2 shrink-0 min-h-11 px-3 no-underline transition-colors",
                "hover:text-accent hover:underline hover:decoration-solid hover:decoration-1 hover:underline-offset-4",
                // Active is marked with a quiet dotted underline rather than the
                // accent, which pulled the eye away from the page content.
                // Hover still swaps to accent + a solid underline.
                "text-ink",
                active && "font-medium underline decoration-dotted decoration-1 underline-offset-[6px]",
              ]}
              aria-current={active ? "page" : undefined}
            >
              {showIcons && item.icon && (
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="shrink-0 opacity-80"
                  set:html={item.icon}
                />
              )}
              <span>{item.label}</span>
            </a>
          );
        })}
      </nav>
    ) : (
      <div />
    )}

    <!-- Trailing slot: search, a tagline, a theme control. Hidden on narrow
         screens so it can never crowd the nav out. -->
    <div class="hidden md:flex items-center justify-end gap-4 shrink-0">
      <slot />
    </div>
  </div>
</header>
