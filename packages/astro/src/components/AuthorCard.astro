---
/**
 * AuthorCard — avatar, name, short bio, and a row of links.
 *
 * Written once in site config and rendered on every article, so it takes its
 * content entirely through props.
 *
 *   rail   — stacked, for a narrow side column
 *   inline — avatar beside the text, for an article byline or footer; the
 *            eyebrow joins the name on one line rather than sitting above it
 *
 * With no `avatar`, it draws a lettered placeholder from the name rather than
 * a stock face — honest about being a placeholder, and stable across renders.
 *
 * The parts carry stable class names — `.author-avatar`, `.author-name`,
 * `.author-bio`, `.author-link` — so a consumer restyling the card targets a
 * name rather than `p:first-of-type`. Structural selectors into a component's
 * markup break silently the first time that markup gains an element; these are
 * API, and listed as such in CLAUDE.md.
 */

export type AuthorLink = {
  label: string;
  href: string;
  /** Raw SVG inner content, rendered inside a 24×24 viewBox. */
  icon?: string;
  /**
   * How the icon is drawn. Brand glyphs are usually single filled paths;
   * line icons are stroked. Defaults to stroke.
   */
  iconStyle?: "stroke" | "fill";
};

type Props = {
  name: string;
  avatar?: string;
  bio?: string;
  links?: AuthorLink[];
  variant?: "rail" | "inline";
  /** Small label above the name, e.g. "Written by". */
  eyebrow?: string;
  /**
   * Makes the whole card a link — a byline usually wants to reach an about
   * page. Only the NAME is a real anchor; it stretches over the card with a
   * pseudo-element, so the click target is the whole block while the
   * accessible name stays "Tomasz Tomczyk" rather than the entire bio.
   *
   * This is why it is a prop and not something a consumer does by wrapping the
   * component: an `<a>` around the card nests anchors the moment `links` is
   * non-empty, which is invalid. Here the two coexist — `links` sit above the
   * stretched layer and stay independently clickable.
   */
  href?: string;
  /**
   * Avatar size. One default for both variants — the size is the consumer's
   * call, not something the layout should infer. (Before this prop existed,
   * `inline` silently drew 3.5rem and `rail` 4rem; nobody could see the 8px
   * and no rationale was ever written down for it.) `lg` is for a byline where
   * the portrait is the point rather than a thumbnail beside the name.
   */
  avatarSize?: "sm" | "md" | "lg";
  class?: string;
};

const {
  name,
  avatar,
  bio,
  links = [],
  variant = "rail",
  eyebrow,
  href,
  avatarSize,
  class: className = "",
} = Astro.props as Props;

const inline = variant === "inline";

/** "Tomasz Tomczyk" -> "TT"; falls back to the first character. */
const initials =
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .join("") || name[0]?.toUpperCase() || "?";

const AVATAR_SIZES = { sm: "size-14", md: "size-16", lg: "size-22" } as const;
const avatarClass = AVATAR_SIZES[avatarSize ?? "md"];
---

<div
  class:list={[
    "author-card",
    href && "author-card-linked",
    inline ? "flex items-start gap-4" : "flex flex-col items-start gap-3",
    className,
  ]}
>
  {avatar ? (
    <img
      src={avatar}
      alt=""
      width="64"
      height="64"
      loading="lazy"
      decoding="async"
      class:list={[
        "author-avatar rounded-full object-cover shrink-0 bg-raised",
        avatarClass,
      ]}
    />
  ) : (
    <div
      class:list={[
        "author-avatar avatar-placeholder rounded-full shrink-0 grid place-items-center bg-raised border border-line",
        avatarClass,
      ]}
      aria-hidden="true"
      title="Avatar placeholder"
    >
      <span class="font-display text-ink/70 text-xl leading-none tracking-wide">
        {initials}
      </span>
    </div>
  )}

  <div class="min-w-0">
    {/* Inline puts the label and the name on one line in one face — the
        byline reads as a sentence. Rail stacks it, where the column is narrow. */}
    {inline ? (
      <p class="author-name font-display text-lg text-ink leading-snug">
        {eyebrow && <span>{eyebrow} </span>}
        {href ? <a href={href} class="author-name-link">{name}</a> : name}
      </p>
    ) : (
      <>
        {eyebrow && <p class="meta">{eyebrow}</p>}
        <p class="author-name font-display text-lg text-ink leading-snug">
          {href ? <a href={href} class="author-name-link">{name}</a> : name}
        </p>
      </>
    )}

    {bio && <p class="author-bio mt-1 text-ink/85 leading-relaxed">{bio}</p>}

    {links.length > 0 && (
      <ul class="author-links flex flex-wrap items-center gap-4 mt-3 list-none p-0 m-0">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="author-link inline-flex items-center gap-1.5 no-underline"
              rel={link.href.startsWith("http") ? "me noopener" : undefined}
              target={link.href.startsWith("http") ? "_blank" : undefined}
            >
              {link.icon ? (
                <>
                  {link.iconStyle === "fill" ? (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="shrink-0"
                      aria-hidden="true"
                      set:html={link.icon}
                    />
                  ) : (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="shrink-0"
                      aria-hidden="true"
                      set:html={link.icon}
                    />
                  )}
                  <span class="sr-only">{link.label}</span>
                </>
              ) : (
                <span>{link.label}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</div>

<style>
  /* Matches the link convention: accent on hover, never a filled background.
     Icons sit at the same grey as .meta — at full ink a row of brand glyphs
     reads as loud as the name above it, which is not the hierarchy.

     The underline on hover matches `.nav-item`: colour alone is a weak
     affordance at this size, and it is the one cue that survives a consumer
     re-pointing the accent token. Drawn as a border so it clears descenders. */
  .author-card :global(.author-link) {
    color: color-mix(in srgb, var(--color-ink) 68%, var(--color-surface));
    border-bottom: 1px solid transparent;
    transition: color 140ms ease, border-color 140ms ease;
  }
  .author-card :global(.author-link:hover) {
    color: var(--color-accent);
    border-bottom-color: currentColor;
  }

  /* The stretched link. The anchor wraps only the name — so that is what a
     screen reader announces — and its ::after covers the card to give pointers
     the whole block. `.author-link` is raised above that layer so the social
     row stays independently clickable. */
  .author-card-linked {
    position: relative;
  }
  .author-card :global(.author-name-link) {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 140ms ease, border-color 140ms ease;
  }
  .author-card :global(.author-name-link::after) {
    content: "";
    position: absolute;
    inset: 0;
  }
  .author-card-linked:hover :global(.author-name-link) {
    color: var(--color-accent);
    border-bottom-color: currentColor;
  }
  .author-card :global(.author-links) {
    position: relative;
  }
</style>
